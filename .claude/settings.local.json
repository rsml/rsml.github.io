      "Bash(curl -s -o /dev/null -w 'sortable.js: %{http_code}\\\\n' http://127.0.0.1:4399/vendor/sortable.js)",
      "Bash(curl -s -o /dev/null -w 'traversal: %{http_code}\\\\n' --path-as-is \"http://127.0.0.1:4399/../package.json\")",
      "Bash(curl -s -X POST \"http://127.0.0.1:4399/api/upload?slug=tutor&name=test-pixel.png\" --data-binary @/tmp/test-pixel.png)",
      "Bash(curl -s -X POST \"http://127.0.0.1:4399/api/upload?slug=tutor&name=clip.mp4\" --data-binary @/tmp/test-pixel.png)",
      "Bash(perl -pi -e 's/^\\(    sortables\\\\.push\\\\\\(new Sortable\\\\\\(\\(?:links|strip\\), \\\\{|  sortables\\\\.push\\\\\\(new Sortable\\\\\\(projectsEl, \\\\{\\)$/$1\\\\n      forceFallback: true,/ if /new Sortable/' tools/editor/public/editor.js)",
      "Bash(sips -s format png /tmp/editor-pdf-test.pdf --out /tmp/editor-pdf-poster.png)",
      "Bash(qlmanage -h)",
      "Bash(ffmpeg -f lavfi -i color=c=steelblue:s=640x360:d=1 -pix_fmt yuv420p /tmp/editor-test-clip.mp4 -y -loglevel error)",
      "Bash(curl -s -X POST \"http://127.0.0.1:4399/api/upload?slug=tutor&name=editor-pdf-test.pdf\" --data-binary @/tmp/editor-pdf-test.pdf)",
      "Bash(curl -s -X POST \"http://127.0.0.1:4399/api/upload?slug=tutor&name=editor-test-clip.mp4\" --data-binary @/tmp/editor-test-clip.mp4)",
      "Bash(curl -s -X POST \"http://127.0.0.1:4399/api/webshot?slug=tutor&url=https%3A%2F%2Fexample.com%2F\")",
      "Bash(curl -s -m 30 -X POST \"http://127.0.0.1:4399/api/webshot?slug=tutor&url=https%3A%2F%2Fexample.com%2F\")",
      "Bash(sips -g pixelWidth -g pixelHeight public/sms/embed-example.com-poster.png)",
      "Bash(ffmpeg -version)",
      "Bash(rm -rf /tmp/vidtest)",

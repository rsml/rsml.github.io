---
/**
 * Full-screen gallery lightbox for the home work rows.
 *
 * Two nested Swipers:
 *   - vertical  (one slide per project) — touch-locked; move between projects
 *     only with the "Previous/Next project" controls (or ↑/↓ keys). Each project
 *     slide carries its OWN header (logo + title + role) and counter, so the
 *     header/counter travel WITH the image during the vertical transition.
 *   - horizontal (one slide per asset: image, gif, video, or web-view embed),
 *     momentum swipe / ◀ ▶ / ← →.
 *
 * Fixed chrome (does not move): close ✕, ◀ ▶ image arrows, and the Next-project
 * control. The Previous-project control matches it visually but is rendered PER
 * SLIDE, centred between the header and the image: being in flow, it can never
 * overlap the variable-height header, and .lb-dragging-y fades it during
 * vertical moves so it animates exactly like the fixed pill. Everything else
 * lives inside the slide.
 */
import { youtubeId, type Project } from '../data/work';
import ActionLinks from './ActionLinks.astro';
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const galleries = projects.filter((p) => p.assets.length > 0);

// The same link list as the home row (deepDive + platform links), with
// internal/external derived from the href. The home row shows these inline as
// "destination" links; in the lightbox the SAME list (same ActionLinks
// component, `menu` variant) tucks behind a per-project "Links" dropdown,
// rendered as an iOS-style list-picker.
const linksFor = (p: Project) => [
  ...(p.deepDive ? [{ label: 'Deep dive', href: `/craft/${p.slug}/`, primary: true }] : []),
  ...p.links,
].map((a) => ({ ...a, external: /^https?:/.test(a.href) }));

// Precompute each video shot's exact aspect ratio from its poster's real pixel size, so the
// player box renders at the right shape from the FIRST paint. Without this, the box used the
// CSS fallback (16/9) until the video's metadata loaded, then snapped to the true ratio: the
// "shrinks while loading, then grows" jump. Build-time only (sharp reads the file header);
// missing/unreadable posters just fall back to the CSS var default.
// @ts-ignore - sharp ships types at lib/index.d.ts that don't resolve via package.json "exports"; build-time only.
import sharp from 'sharp';
const aspectFor = new Map<string, string>();
for (const p of galleries) {
  for (const s of p.assets) {
    if (s.type === 'video' && s.poster) {
      try {
        const m = await sharp(process.cwd() + '/public' + s.poster).metadata();
        if (m.width && m.height) aspectFor.set(s.src, `${m.width} / ${m.height}`);
      } catch { /* no poster dims -> CSS fallback */ }
    }
  }
}
---
<div class="lb" id="lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Project gallery">
  <div class="lb-backdrop"></div>

  <!-- fixed chrome -->
  <button class="lb-btn lb-close" type="button" aria-label="Close gallery">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button class="lb-pjump lb-down" type="button" aria-label="Next project">
    <span>Next project</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9l7 7 7-7"/></svg>
  </button>
  <button class="lb-btn lb-arrow lb-prev" type="button" aria-label="Previous image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <button class="lb-btn lb-arrow lb-next" type="button" aria-label="Next image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>

  <div class="lb-vert swiper">
    <div class="swiper-wrapper">
      {galleries.map((p, i) => {
        const actions = linksFor(p);
        return (
        <div class="swiper-slide lb-project" data-slug={p.slug} data-device={p.device}>
          <div class="lb-stage">
            <header class="lb-phead">
              {p.thumbImage && (
                <span class:list={['lb-plogo', p.thumbClass]}>
                  <img src={p.thumbImage} alt="" />
                </span>
              )}
              <div class="lb-phead-text">
                <p class="lb-prole">{p.role}</p>
                <p class="lb-ptitle">
                  <span class="lb-pname">{p.cardTitle}</span>
                  <span class="lb-psub">{p.subtitle}</span>
                </p>
                {actions.length > 0 && (
                  <details class="lb-links">
                    <summary class="lb-links-summary">
                      <span>Links</span>
                      <svg class="lb-links-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                    </summary>
                    <div class="lb-links-panel">
                      <ActionLinks actions={actions} label={`${p.cardTitle} links`} menu />
                    </div>
                  </details>
                )}
              </div>
            </header>

            {i > 0 && (
              <button class="lb-pjump lb-up" type="button" aria-label="Previous project">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 15l7-7 7 7"/></svg>
                <span>Previous project</span>
              </button>
            )}

            <div class:list={['lb-horiz', 'swiper', `lb-horiz--${p.assets[0].orientation}`]}>
              <div class="swiper-wrapper">
                {p.assets.map((s) => (
                  <div class:list={['swiper-slide', 'lb-shot', `lb-shot--${s.type}`]} data-orientation={s.orientation} style={aspectFor.has(s.src) ? `--plyr-ar: ${aspectFor.get(s.src)}` : undefined}>
                    {s.type === 'video' ? (
                      // Plyr enhances this <video> on first open (see script). `controls`
                      // is kept as the no-JS fallback; Plyr removes it when it takes over.
                      // Cold start: BOTH the src and the poster are deferred. The real URL
                      // rides on data-lb-src (not src) so a plain page load holds ZERO
                      // src-attached <video> elements. On iOS WebKit every src-attached
                      // media element costs a resident player allocation, and all ~34 of
                      // them at once (the whole portfolio's clips live in this one lightbox)
                      // is what jetsam-killed the tab on open. syncMedia/restoreVideoSrc
                      // attaches src for the active project only, on open; preload="none"
                      // keeps even those cold until the active shot upgrades to 'metadata'.
                      // The poster is deferred the same way (syncMedia moves data-lb-poster
                      // onto the element once its shot is the open slide); the strip
                      // thumbnails already display these poster URLs, so the deferred apply
                      // is normally an HTTP-cache hit. The attribute is data-lb-poster, NOT
                      // data-poster, on purpose: Plyr auto-loads any `data-poster` it finds
                      // on init (getAttribute('poster')||getAttribute('data-poster')), which
                      // would eagerly decode all ~34 full posters at once and OOM-kill the
                      // tab on iOS. Our own name hides it from Plyr until we set plyr.poster
                      // for the active shot.
                      <video class="lb-media lb-video" data-lb-src={s.src} data-lb-poster={s.poster} controls playsinline preload="none"></video>
                    ) : s.type === 'youtube' ? (
                      // YouTube, played through the SAME Plyr player as local video (so it
                      // gets the themed controls, not YouTube's chrome). Plyr builds the
                      // iframe from these data-attrs on first open and fetches the poster.
                      <div class="lb-media lb-youtube" data-plyr-provider="youtube" data-plyr-embed-id={youtubeId(s.src)}></div>
                    ) : s.type === 'embed' || s.type === 'pdf' ? (
                      // Web view OR PDF (the browser's native viewer): lazy. `data-src`
                      // becomes `src` only while this project is the open slide (and is
                      // cleared on leave/close) so embeds never load or play off-screen.
                      <iframe class="lb-media lb-embed" data-src={s.type === 'pdf' ? `${s.src}#view=FitH&toolbar=0` : s.src} title={s.alt}
                        loading="lazy" allow="autoplay; fullscreen; clipboard-write; encrypted-media"
                        allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
                    ) : (
                      // image + gif (a GIF is just an <img> that animates).
                      <img class="lb-media" src={s.src} alt={s.alt} loading="lazy" decoding="async" draggable="false" />
                    )}
                  </div>
                ))}
              </div>
            </div>

            <p class="lb-pcount"></p>
          </div>
        </div>
        );
      })}
    </div>
  </div>

  <div class="lb-grain"></div>
</div>

<style is:global>
  /* Critical stub: keeps the lightbox invisible and fixed while build() loads.
     Everything else lives in lightbox.css, injected as a <style> on first open. */
  html.lb-open { overflow: hidden; }
  .lb { position: fixed; inset: 0; z-index: 1000; opacity: 0; transition: opacity 240ms ease; }
  .lb.is-open { opacity: 1; }

</style>

<script>
  import type Swiper from 'swiper';
  import type Plyr from 'plyr';

  type Controller = {
    el: HTMLElement;
    open: (slug: string, index: number) => void;
    close: () => void;
    nav: (key: string) => void;
  };

  // Live Swipers + Plyr players for the current page's lightbox, tracked at module
  // scope so we can destroy them before an Astro view-transition swaps the DOM.
  let instances: Swiper[] = [];
  // Each Plyr is stored with the .lb-shot it lives in (captured at creation), so
  // syncMedia can pause off-screen players without poking at Plyr internals.
  let players: { plyr: Plyr; shot: HTMLElement | null }[] = [];
  let current: Controller | null = null;

  // ── Crash diagnostics (debug-only: ?lbdebug=1, + ?autodrive to auto-swipe vertically). The
  // trail survives the iOS jetsam reload via localStorage and paints on the next load. Each mark
  // logs the counters that bisect the crash hypotheses: rendered = project panels NOT .lb-far
  // (virtualization working? should stay <=3), farCV = a far panel's computed content-visibility
  // ('h'idden = the cap is actually applied on iOS), media = total <video> els, vidSrc = videos
  // holding a decoder, imgMP = decoded image MB/4, dom, heapMB (null on iOS). Zero work without ?lbdebug.
  const LB_QS = (() => { try { return new URLSearchParams(location.search); } catch { return new URLSearchParams(); } })();
  const LB_DEBUG = LB_QS.has('lbdebug');
  const LB_AUTODRIVE = LB_QS.has('autodrive');
  let lbTrail: any[] = [];
  let lbRecovered = false;
  let autodriveRan = false;
  function lbMark(step: string) {
    if (!LB_DEBUG) return;
    try {
      const panels = Array.from(document.querySelectorAll('.lb-project'));
      const far = panels.filter((p) => p.classList.contains('lb-far'));
      const vids = Array.from(document.querySelectorAll('video.lb-video')) as HTMLVideoElement[];
      const mem = (performance as any).memory;
      let imgMP = 0;
      for (const im of Array.from(document.images)) if (im.complete && im.naturalWidth) imgMP += (im.naturalWidth * im.naturalHeight) / 1e6;
      lbTrail.push({
        step,
        rendered: panels.length - far.length,
        farCV: far[0] ? getComputedStyle(far[0]).contentVisibility[0] : '-',
        media: vids.length,
        vidSrc: vids.filter((v) => v.hasAttribute('src')).length,
        ready: vids.filter((v) => v.readyState > 0).length,
        imgMP: Math.round(imgMP),
        dom: document.getElementsByTagName('*').length,
        heapMB: mem ? Math.round(mem.usedJSHeapSize / 1048576) : null,
        vis: document.visibilityState[0],
      });
      if (lbTrail.length > 220) lbTrail.splice(0, lbTrail.length - 220);
      localStorage.setItem('lb-trail', JSON.stringify(lbTrail));
      lbPaintLive();
    } catch {}
  }
  // Live on-screen readout (debug-only): the last marks, updated each mark, no reload/crash needed.
  // pointer-events:none so it never eats the autodrive's touches. This is how the WebKit counters get
  // captured in the simulator (which won't OOM-reload, so the crash-recovery painter never fires).
  let lbLiveEl: HTMLElement | null = null;
  function lbPaintLive() {
    if (!LB_DEBUG || !document.body) return;
    if (!lbLiveEl) {
      lbLiveEl = document.createElement('pre');
      lbLiveEl.style.cssText = 'position:fixed;top:0;left:0;right:0;max-height:46vh;z-index:2147483645;margin:0;padding:6px 8px;overflow:hidden;background:rgba(0,0,0,.86);color:#0f0;font:9px/1.25 ui-monospace,monospace;pointer-events:none;white-space:pre;';
      document.body.appendChild(lbLiveEl);
    }
    const last = lbTrail.slice(-16);
    const rows = last.map((e) => `${String(e.rendered).padStart(2)} cv:${e.farCV} md:${e.media} src:${e.vidSrc} rdy:${e.ready} mp:${String(e.imgMP).padStart(3)} dom:${e.dom}  ${e.step}`);
    lbLiveEl.textContent = 'rndrd cv md src rdy  mp  dom   step\n' + rows.join('\n');
  }
  let lbRecoverRan = false;
  function lbRecoverTrail() {
    if (!LB_DEBUG || lbRecoverRan) return;
    lbRecoverRan = true;   // once per real page load; a double astro:page-load must not re-read our own fresh trail
    let prior: string | null = null;
    try { prior = localStorage.getItem('lb-trail'); localStorage.removeItem('lb-trail'); } catch {}
    lbTrail = [];
    if (!prior || prior === '[]' || !document.body) return;
    let arr: any[] = []; try { arr = JSON.parse(prior); } catch {}
    if (!arr.some((e: any) => e && typeof e.step === 'string' && !/^(pagehide|vis:)/.test(e.step))) return;
    lbRecovered = true;   // a real crash trail survived: paint it, and suppress autodrive this load
    const pre = document.createElement('pre');
    pre.textContent = 'LB CRASH trail (tap to dismiss):\n\n' + prior.replace(/\},\{/g, '},\n{');
    pre.style.cssText = 'position:fixed;inset:6px;z-index:2147483647;margin:0;padding:10px;overflow:auto;background:#000;color:#0f0;font:10px/1.4 ui-monospace,monospace;border:2px solid #0f0;white-space:pre-wrap;word-break:break-word;';
    pre.addEventListener('click', () => pre.remove());
    document.body.appendChild(pre);
  }
  if (LB_DEBUG) {
    addEventListener('error', (e) => lbMark('ERROR:' + ((e as ErrorEvent).message || '').slice(0, 40)));
    addEventListener('pagehide', () => lbMark('pagehide'));
  }

  function destroyInstances() {
    for (const s of instances) { try { s.destroy(true, true); } catch {} }
    for (const { plyr } of players) { try { plyr.destroy(); } catch {} }
    instances = [];
    players = [];
  }

  function setupLightbox() {
    const lb = document.getElementById('lightbox') as HTMLElement | null;
    if (!lb) { current = null; return; }
    if (lb.dataset.ready === '1' && current && current.el === lb) return;
    lb.dataset.ready = '1';

    const vertEl = lb.querySelector('.lb-vert') as HTMLElement;
    const prevBtn = lb.querySelector('.lb-prev') as HTMLElement;
    const nextBtn = lb.querySelector('.lb-next') as HTMLElement;
    const downBtn = lb.querySelector('.lb-down') as HTMLElement;
    const closeBtn = lb.querySelector('.lb-close') as HTMLElement;

    let vert: Swiper | null = null;
    let horiz: Swiper[] = [];
    let built = false;
    let buildPromise: Promise<void> | null = null;
    let lastFocus: HTMLElement | null = null;
    // The shot we last autoplayed. syncMedia restarts a clip only when this changes,
    // so a project-change's double syncMedia (or any re-sync that doesn't move the
    // slide) can't restart a clip mid-play. Reset on close so a reopen replays.
    let lastActiveShot: HTMLElement | null = null;

    const projects = () => Array.from(vertEl.querySelectorAll('.lb-project')) as HTMLElement[];
    const activeHoriz = () => horiz[vert ? vert.activeIndex : 0];
    const show = (el: HTMLElement, on: boolean) => el.classList.toggle('is-hidden', !on);

    // Per-project counter lives inside the slide, so it travels with the image.
    function updateCount(h: Swiper) {
      const slide = (h.el as HTMLElement).closest('.lb-project');
      const c = slide?.querySelector('.lb-pcount');
      if (c) c.textContent = `${h.activeIndex + 1} / ${h.slides.length}`;
    }

    function syncUI() {
      if (!built || !vert) return;
      const h = activeHoriz();
      if (!h) return;
      show(prevBtn, !h.isBeginning);
      show(nextBtn, !h.isEnd);
      show(downBtn, !vert.isEnd);
    }

    // Virtualization: keep only the active project panel and its immediate neighbors rendered;
    // mark the rest .lb-far (content-visibility:hidden, see CSS) so the animated vertical swiper
    // never rasterizes more than ~3 panels. Called on open and on every vertical slideChange, so
    // the rendered window of projects slides along with you and never accumulates.
    function updateFarPanels() {
      if (!vert) return;
      const a = vert.activeIndex;
      projects().forEach((slide, i) => slide.classList.toggle('lb-far', Math.abs(i - a) > 1));
    }

    // Shot-level twin of updateFarPanels (see the .lb-far-shot CSS). Within one project's
    // horizontal swiper, mark every shot beyond the active +/- 1 as .lb-far-shot so the browser
    // drops its decoded image bitmap. Without this, arriving at an image-heavy project decoded all
    // its shots at once (SMS: ~14 full-res JPEGs -> ~84 MB image-memory spike -> iOS jetsam OOM,
    // the imgMP 13->34 jump in the on-device crash trail). Called per horiz on its slideChange,
    // for the incoming project on a vertical slideChange, and for every project on open.
    function updateFarShots(h: Swiper | null | undefined) {
      if (!h) return;
      const a = h.activeIndex;
      Array.from(h.slides as ArrayLike<HTMLElement>).forEach((slide, i) =>
        slide.classList.toggle('lb-far-shot', Math.abs(i - a) > 1),
      );
    }

    // Release a local <video>'s decode buffers by detaching its src. iOS WebKit
    // enforces a strict per-tab memory budget (jetsam) and keeps decoded frames
    // resident as long as the src attribute is present. Removing the src and
    // calling load() signals the browser to free the decoder and buffer memory.
    // The Plyr wrapper is left alive; it tolerates a temporarily src-less element.
    // The original src is stashed in data-lb-src so it can be restored later.
    function releaseVideoMemory(video: HTMLVideoElement) {
      if (!video.hasAttribute('src')) return;   // already detached, nothing to free (this is the
      // critical guard: the old `readyState === 0` test skipped never-loaded videos, so the
      // open-time release freed nothing and all ~34 stayed src-attached. Gate on the src
      // attribute instead, so a cold-but-attached video is still detached on open.
      if (!video.dataset.lbSrc) {
        // Stash the live src attribute (fall back to the element property, which
        // holds the resolved URL even when set via JS rather than HTML).
        video.dataset.lbSrc = video.getAttribute('src') || video.src || '';
      }
      video.removeAttribute('src');
      video.preload = 'none';
      try { video.load(); } catch {}   // signals WebKit to free decoder and buffers
    }

    // Restore a local <video>'s src from data-lb-src (written by releaseVideoMemory,
    // or shipped in the server markup so the first open attaches the active project).
    // preload stays 'none' so restoring the attribute alone does not trigger a
    // fetch; the existing poster/preload/autoplay logic below upgrades the active
    // shot to 'metadata' and starts play when appropriate.
    function restoreVideoSrc(video: HTMLVideoElement) {
      if (!video.dataset.lbSrc) return;   // never released, nothing to restore
      if (!video.getAttribute('src')) {
        video.setAttribute('src', video.dataset.lbSrc);
        video.preload = 'none';   // explicit: keep cold until the active-shot path upgrades it
      }
      delete video.dataset.lbSrc;
    }

    // Media follows the active slide: the active project's embeds load (data-src →
    // src) while every other embed is blanked, and any video that isn't the active
    // shot of the active project is paused, so nothing loads or plays off-screen.
    // syncMedia: VISUAL prep only, safe to run mid-glide. It shows the active shot's poster
    // (so the card is a static thumb while it slides, never a blank box), pauses every other
    // player, and points the embeds at the active project. It deliberately does NOT load, play,
    // or detach any video src; that heavy/visible work is deferred to activateActiveVideo() on
    // settle (see scheduleActivate), so the glide is pure motion of stills with no flash.
    function syncMedia() {
      if (!vert) return;
      const ap = vert.activeIndex;
      // Embeds load for the active project and blank for the rest (iframes, separate budget).
      projects().forEach((slide, pi) => {
        const projActive = pi === ap;
        slide.querySelectorAll('iframe.lb-embed').forEach((node) => {
          const f = node as HTMLIFrameElement;
          const ds = f.dataset.src || '';
          if (projActive && ds) {
            if (f.getAttribute('src') !== ds) f.setAttribute('src', ds);
          } else if (f.getAttribute('src')) {
            f.removeAttribute('src');   // blank off-screen embeds: stops their audio/video
          }
        });
      });
      // The visible slide drives playback: pause any Plyr player (local <video> OR
      // youtube embed) that isn't the active shot of the active project. A youtube
      // player has no <video> element, so we pause through the Plyr instance, which
      // covers both kinds uniformly.
      const ah = activeHoriz();
      const activeShot = ah ? (ah.slides[ah.activeIndex] as HTMLElement) : null;
      for (const { plyr, shot } of players) {
        if (plyr.playing && shot !== activeShot) {
          try { plyr.pause(); } catch {}
        }
      }
      // Deferred poster for the ACTIVE SHOT ONLY. Applying every poster in
      // a project at once was the iOS crash: each 1920x1200 still decodes to ~9 MB of
      // RGBA (x2, since Plyr keeps its own poster <img>), so arriving at a six-video
      // project like Tutor burst ~100 MB of bitmaps during the slide transition and
      // WKWebView OOM-killed the tab (which iOS shows as the page reloading itself;
      // Chrome on iOS gets a tighter per-tab budget than Safari, so it tips first).
      // The active shot is the only poster on screen anyway; the others get theirs
      // when swiped to (a strip-thumbnail cache hit), exactly like the preload
      // deferral. Off-screen videos stay cold: no poster, no metadata, no decode.
      const activeEntry = activeShot ? players.find((p) => p.shot === activeShot) : null;
      const activeVideo = (activeEntry?.shot?.querySelector('video') as HTMLVideoElement | null) ?? null;
      if (activeEntry && activeVideo) {
        const shotEl = activeEntry.shot!;
        const poster = activeVideo.dataset.lbPoster;   // NOT dataset.poster: see markup comment (hidden from Plyr's eager auto-load)
        if (poster && !activeVideo.getAttribute('poster')) {
          activeVideo.setAttribute('poster', poster);
          try { activeEntry.plyr.poster = poster; } catch {}
          // Shape the player box from this poster before the video's metadata lands,
          // but only for the shot on screen (one decode, not 34). Skip if metadata
          // already set --plyr-ar.
          if (!shotEl.style.getPropertyValue('--plyr-ar')) {
            const img = new Image();
            img.onload = () => { if (img.naturalWidth > 0) shotEl.style.setProperty('--plyr-ar', `${img.naturalWidth} / ${img.naturalHeight}`); };
            img.src = poster;
          }
        }
      }
    }

    // activateActiveVideo: the heavy/visible media work, run AFTER a glide settles (via
    // scheduleActivate) or immediately on open, never mid-glide. Per-SHOT src ownership (only
    // the settled shot keeps a src, so at most one decoder is resident: the iOS crash fix) plus
    // the preload upgrade and the autoplay. The poster set in syncMedia keeps showing until the
    // first frame decodes, so playback starts in place with no black flash and no jump.
    function activateActiveVideo() {
      if (!vert || !current || current.el.hidden) return;   // bail if the lightbox closed before the timer fired
      const ah = activeHoriz();
      const activeShot = ah ? (ah.slides[ah.activeIndex] as HTMLElement) : null;
      const activeShotVideo = (activeShot?.querySelector('video.lb-video') as HTMLVideoElement | null) ?? null;
      (Array.from(document.querySelectorAll('video.lb-video')) as HTMLVideoElement[]).forEach((video) => {
        if (video === activeShotVideo) restoreVideoSrc(video);
        else releaseVideoMemory(video);
      });
      if (activeShotVideo && activeShotVideo.preload === 'none') activeShotVideo.preload = 'metadata';
      if (activeShot !== lastActiveShot) {
        lastActiveShot = activeShot;
        const entry = players.find((p) => p.shot === activeShot);
        if (entry) {
          // Robust autoplay across REVISITS. On a revisit the video was released (src detached
          // + load()) and is not loaded when we get here, so an immediate play() can no-op.
          // tryPlay runs now (works first-visit / already-loaded) AND once more on 'canplay'
          // (when a just-restored video becomes ready), guarded to the still-active shot.
          const shot = activeShot;
          // Arm the loading hand-off NOW (poster held, play button hidden) so the button never
          // blips during the autoplay attempt; the play/timeupdate listeners (in build) reveal it
          // on the first frame. Safety: drop the hold after 4s so a clip that never paints can't
          // leave the poster stuck; if autoplay is refused, drop it immediately so the play button
          // returns for a manual tap.
          shot?.classList.add('lb-arming');
          const disarm = () => shot?.classList.remove('lb-arming');
          const armSafety = setTimeout(disarm, 4000);
          try { entry.plyr.currentTime = 0; } catch {}   // reset to the top ONCE, not on every retry
          const tryPlay = () => {
            // Skip if no longer the active shot, or already playing: the canplay retry must not
            // seek/restart a play that already began (that interruption broke first-play autoplay).
            if (lastActiveShot !== shot || entry.plyr.playing) return;
            try { Promise.resolve(entry.plyr.play()).catch(() => { clearTimeout(armSafety); disarm(); }); }
            catch { clearTimeout(armSafety); disarm(); }
          };
          tryPlay();   // works first-visit / already-loaded
          // Retry once a just-restored (revisit) video becomes ready, if it didn't start above.
          (entry.shot?.querySelector('video') as HTMLVideoElement | null)?.addEventListener('canplay', tryPlay, { once: true });
        }
      }
    }

    // Debounced activation: fire activateActiveVideo once the slide motion has landed. The
    // "max target" guard means a same-tick event with a shorter duration (e.g. the horizontal
    // reset-to-shot-0 that a project change triggers) can never pull the activation EARLIER and
    // fire it mid-glide; the longest pending transition wins.
    let activateTimer: ReturnType<typeof setTimeout> | undefined;
    let activateAt = 0;
    function scheduleActivate(speed?: number) {
      const now = performance.now();
      const target = now + Math.max(0, speed ?? 0) + 20;
      if (target <= activateAt) return;
      activateAt = target;
      clearTimeout(activateTimer);
      activateTimer = setTimeout(() => { activateAt = 0; activateActiveVideo(); }, target - now);
    }

    // Hard stop for close(): pause every player (video + youtube), blank every embed,
    // and release local video decode buffers. iOS WebKit (jetsam) keeps buffered video
    // memory resident across navigation unless src is removed and load() is called.
    // Releasing here means the tab holds no decode state once the gallery is closed.
    // Reopening calls open() -> syncMedia(), which restores the active project's src
    // before the existing autoplay logic runs, so reopening still works correctly.
    function stopAllMedia() {
      for (const { plyr } of players) { try { plyr.pause(); } catch {} }
      projects().forEach((slide) => {
        slide.querySelectorAll('iframe.lb-embed').forEach((f) => { if (f.getAttribute('src')) f.removeAttribute('src'); });
        slide.querySelectorAll('video.lb-video').forEach((node) => {
          releaseVideoMemory(node as HTMLVideoElement);
        });
      });
    }

    // While a swipe is in flight, dim the fixed directional nav so it isn't left
    // pinned over the moving content; it fades back in once the slide settles. The
    // image arrows dim on any swipe; the project pills dim only on a vertical
    // (between-projects) swipe, since a horizontal page stays within one project and
    // keeps the pills relevant. The header and counter live inside the slide, so they
    // keep travelling with it; only this global chrome dims. We remember the swiper
    // that's actually dragging so the OTHER (perpendicular, nested) swiper's touch-end,
    // which also fires on the shared pointer release, can't clear the dim mid-settle.
    // sliderMove (not touchStart) gates on a real drag, so taps never dim.
    // Button/keyboard project jumps reuse the same classes (goProject); fadeTimer
    // is the single pending fade-in for either path, so every new gesture (drag or
    // jump) cancels the previous one before taking over.
    // FADE_IN_MS is how long the chrome takes to fade back in (must match the
    // 160ms base .lb-pjump/.lb-btn opacity transitions in the CSS above). The
    // fade-in is scheduled to START this long before a slide transition lands, so
    // it completes right at settle instead of popping in after it.
    const FADE_IN_MS = 160;
    let dragSwiper: Swiper | null = null;
    let fadeTimer: ReturnType<typeof setTimeout> | undefined;
    const dragStart = (sw: Swiper) => {
      dragSwiper = sw;
      clearTimeout(fadeTimer);
      lb!.classList.add('lb-dragging');                                            // arrows: any axis
      if (sw.params.direction === 'vertical') lb!.classList.add('lb-dragging-y');  // pills: up/down only
    };
    const dragSettle = (sw: Swiper) => {
      if (sw !== dragSwiper) return;
      dragSwiper = null;
      clearTimeout(fadeTimer);
      lb!.classList.remove('lb-dragging', 'lb-dragging-y');
    };
    // On release, Swiper emits touchEnd BEFORE it computes the post-release snap,
    // so sw.animating is still false at this instant even when a snap is about to
    // run (and an immediate settle would fade the chrome back in OVER the still-
    // moving content). Check one tick later, once it's truthful: no snap means
    // settle now; a running snap animates at params.speed, so schedule the fade-in
    // to complete as it lands. transitionEnd keeps dragSettle armed as the backstop
    // in case the timer misjudges the snap's duration.
    const dragRelease = (sw: Swiper) => {
      if (sw !== dragSwiper) return;
      // Fast vertical FLICKS snap instantly (speed 0 -> no animated transition, so no GPU layer
      // to crash on); slow, deliberate swipes keep the 480ms glide. Rapid animated project
      // transitions were the remaining crash; dropping the animation for fast flicks removes it.
      if (sw.params.direction === 'vertical') sw.params.speed = Math.abs((sw as any).velocity ?? 0) > 0.45 ? 0 : 480;
      if (sw.params.direction === 'vertical') lbMark('drag:v=' + Math.abs((sw as any).velocity ?? 0).toFixed(2) + ':spd=' + sw.params.speed);
      setTimeout(() => {
        if (sw !== dragSwiper) return;
        if (!sw.animating) { dragSettle(sw); return; }
        clearTimeout(fadeTimer);
        fadeTimer = setTimeout(() => dragSettle(sw), Math.max(0, (sw.params.speed ?? 0) - FADE_IN_MS));
      }, 0);
    };

    // Init Swipers lazily on first open — the overlay has real layout by then,
    // so Swiper measures correct sizes (a hidden container measures 0).
    async function build() {
      if (built) return;
      // Load all deferred CSS and JS in parallel. CSS is ?inline so Vite bundles
      // the strings into this module instead of injecting render-blocking <link> tags.
      const [{ default: lbCss }, { default: swiperCss }, { default: plyrCss }, { default: SwiperLib }, { default: PlyrLib }] = await Promise.all([
        import('../styles/lightbox.css?inline'),
        import('swiper/css?inline'),
        import('plyr/dist/plyr.css?inline'),
        import('swiper'),
        import('plyr'),
      ]);
      if (built) return;  // guard against a concurrent open() that finished first
      // Inject all deferred CSS before creating Swipers (lb is still at opacity:0).
      for (const css of [lbCss, swiperCss, plyrCss]) {
        const s = document.createElement('style');
        s.textContent = css;
        document.head.appendChild(s);
      }
      horiz = projects().map((slide) => new SwiperLib(slide.querySelector('.lb-horiz') as HTMLElement, {
        slidesPerView: 1,
        speed: 340,
        threshold: 4,
        touchAngle: 45,          // only near-horizontal drags page assets (axis-lock — see vert)
        resistanceRatio: 0.72,
        // A touch starting on the Plyr controls (scrubber, buttons) or inside a live
        // web-view embed must NOT swipe the carousel; let those elements own the
        // gesture; the ◀ ▶ arrows / ← → keys still page between assets.
        noSwipingSelector: '.plyr__controls, .lb-embed',
        on: {
          init(sw) { updateCount(sw); },
          slideChange(sw) { updateCount(sw); syncUI(); syncMedia(); updateFarShots(sw); scheduleActivate(sw.params.speed); },
          sliderMove: dragStart,
          touchEnd: dragRelease,
          transitionEnd: dragSettle,
        },
      }));
      vert = new SwiperLib(vertEl, {
        direction: 'vertical',
        slidesPerView: 1,
        // Swipe up/down moves between projects, mirroring the horizontal
        // screenshot swipe (the ↑/↓ keys and Previous/Next-project controls still
        // drive it too). touchAngle (45°) axis-locks the gesture: this swiper only
        // engages when a drag is closer to vertical than horizontal, and the inner
        // horizontal swiper only engages on the opposite half — so a diagonal drag
        // moves exactly one axis, never both. You swipe up, down, left, or right,
        // never diagonally. preventClicks now stays at its default (true): with
        // touch enabled, Swiper only blocks the trailing click AFTER a real drag,
        // so a swipe can't fall through to close the gallery while taps (the header
        // "Links" dropdown) still pass through untouched.
        touchAngle: 45,
        threshold: 4,
        // Animated project snap (480ms), made crash-safe by VIRTUALIZATION: updateFarPanels()
        // keeps only the active +/- 1 project panels rendered (the rest get .lb-far ->
        // content-visibility:hidden), so the animating .swiper-wrapper rasterizes ~3 panels, not
        // all 7 x 100vh of media (the whole-stack rasterization was the iOS GPU crash). That is
        // what the horizontal swiper does implicitly, holding one project at a time, which is
        // why horizontal animates fine. (Horizontal shot-swipes keep their own 340ms animation.)
        speed: 480,
        on: {
          slideChange(sw) {
            syncUI();
            updateFarPanels();   // render the new active's neighbors, drop the now-far ones (caps the animated layer)
            lbMark('vchange:' + sw.activeIndex);
            // Incoming project starts on its first shot (both swipe + button paths).
            const h = horiz[sw.activeIndex];
            if (h) h.slideTo(0, 0);
            updateFarShots(h);   // cap the incoming project's decoded shot bitmaps to ~3 (see .lb-far-shot)
            // Prep visuals (poster + pause) now; the active video activates after the glide
            // settles (scheduleActivate), so nothing loads/plays/blanks mid-glide.
            syncMedia();
            scheduleActivate(sw.params.speed);
          },
          sliderMove: dragStart,
          touchEnd: dragRelease,
          transitionEnd: dragSettle,
        },
      });

      // Enhance every local <video> AND every YouTube embed with Plyr, so both wear
      // the same custom controls on mobile + web. `keyboard` is OFF so the lightbox
      // keeps sole ownership of ← → ↑ ↓ / Esc (no seek-vs-navigate conflict). Players
      // are destroyed in destroyInstances() before any view-transition swaps the DOM.
      players = (Array.from(vertEl.querySelectorAll('.lb-video, .lb-youtube')) as HTMLElement[]).map((el) => ({
        shot: el.closest('.lb-shot') as HTMLElement | null,   // captured before Plyr wraps el
        plyr: new PlyrLib(el, {
          // No mute/volume controls: playback is pinned to full volume (below), so a
          // sound UI would only offer a way to break that. play-large stays as the
          // fallback affordance if a browser refuses the unmuted autoplay.
          controls: ['play-large', 'play', 'progress', 'current-time', 'fullscreen'],
          // Sound always on, always max. storage is disabled (below), so this is the
          // state on every open; a prior session can't leave it muted or quiet.
          volume: 1,
          muted: false,
          clickToPlay: true,
          keyboard: { focused: false, global: false },
          tooltips: { controls: false, seek: true },
          storage: { enabled: false },
          ratio: undefined,
          // Applies to youtube players only: privacy domain, no related videos from
          // other channels, hidden annotations + minimal branding.
          youtube: { noCookie: true, rel: 0, modestbranding: 1, iv_load_policy: 3 },
        }),
      }));

      // Size each local video's player box to the clip's own aspect ratio: set
      // --plyr-ar (read by the landscape CSS above) from the video's intrinsic
      // dimensions so a clip proportionally taller than the stage shrinks to fit
      // instead of being cropped. Seed it from the poster (already cached by the
      // strip thumbnail) so the box is right before the slide animates in, then
      // confirm from the video's true size once metadata loads. YouTube players
      // have no <video> and stay 16:9, so they're skipped.
      // Confirm each video's box aspect ratio from its true size once metadata loads
      // (only the active shot ever loads its metadata, see syncMedia). The earlier
      // poster-based seed that shaped the box BEFORE metadata is now applied lazily,
      // active-shot-only, in syncMedia: measuring all 34 posters HERE decoded every
      // full-res still at first open (~270 MB of RGBA, the 10 Vivy stills are
      // 1320x2868 alone), the memory spike iOS WebKit could not survive. The listener
      // is just a callback, so wiring all of them costs nothing until a video loads.
      for (const { shot } of players) {
        const video = shot?.querySelector('video') as HTMLVideoElement | null;
        if (!shot || !video) continue;
        video.addEventListener('loadedmetadata', () => {
          if (video.videoWidth > 0) shot.style.setProperty('--plyr-ar', `${video.videoWidth} / ${video.videoHeight}`);
        });
        // Loading hand-off (see the .lb-arming CSS): hold the poster + hide the play button whenever
        // a clip starts playing WITHOUT a painted frame yet (cold play / manual tap), and reveal it
        // the instant the first frame lands (timeupdate). 'emptied' fires when src is released, so a
        // revisit re-arms from scratch. activateActiveVideo also arms on activation so the button
        // never blips before an autoplay even begins.
        video.addEventListener('play', () => { if (video.readyState < 2) shot.classList.add('lb-arming'); });
        video.addEventListener('timeupdate', () => shot.classList.remove('lb-arming'));
        video.addEventListener('emptied', () => shot.classList.remove('lb-arming'));
      }

      instances = [vert, ...horiz];
      built = true;
    }

    // Previous/Next-project controls + ↑/↓ keys. The slide animates exactly like a
    // vertical swipe, so it gets the same chrome fade, driven by a timer instead of
    // touch events: the dim classes go on the instant the jump starts (50ms
    // fade-out) and come off FADE_IN_MS before the slide settles, so the fade-in
    // completes right as the animation does.
    function goProject(dir: number) {
      if (!vert) return;
      const t = vert.activeIndex + dir;
      if (t < 0 || t > horiz.length - 1) return;
      vert.params.speed = 480;   // button/key project jumps always glide (no flick velocity to read)
      clearTimeout(fadeTimer);
      lb!.classList.add('lb-dragging', 'lb-dragging-y');
      fadeTimer = setTimeout(() => {
        // A drag begun mid-jump owns the classes now; dragSettle clears them instead.
        if (!dragSwiper) lb!.classList.remove('lb-dragging', 'lb-dragging-y');
      }, Math.max(0, (vert.params.speed ?? 0) - FADE_IN_MS));
      // vert's slideChange resets the incoming project to its first shot.
      if (dir > 0) vert.slideNext(); else vert.slidePrev();
    }

    async function open(slug: string, index: number) {
      lastFocus = document.activeElement as HTMLElement;
      // Show the backdrop immediately (opacity:0 → fades in after build); body scroll locks now.
      lb!.hidden = false;
      lb!.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('lb-open');
      if (!buildPromise) buildPromise = build();
      await buildPromise;
      // Always open the lightbox with the per-project "Links" dropdown CLOSED, even if it was
      // left open on a previous view (the <details> elements persist in the built DOM).
      lb!.querySelectorAll('details.lb-links[open]').forEach((d) => ((d as HTMLDetailsElement).open = false));
      let p = projects().findIndex((s) => s.dataset.slug === slug);
      if (p < 0) p = 0;
      vert!.slideTo(p, 0);
      horiz[p].slideTo(index || 0, 0);
      updateFarPanels();   // only the opened project + neighbors render
      horiz.forEach((h) => updateFarShots(h));   // and only ~3 shots per project decode (image-memory cap)
      syncUI();
      syncMedia();
      activateActiveVideo();   // on open there is no glide to wait for; activate the shot now
      requestAnimationFrame(() => lb!.classList.add('is-open'));
      closeBtn.focus({ preventScroll: true });
    }

    function close() {
      stopAllMedia();
      lastActiveShot = null;   // a reopen replays the shown clip from the top
      lb!.classList.remove('is-open');
      document.documentElement.classList.remove('lb-open');
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        lb!.removeEventListener('transitionend', onEnd);
        lb!.hidden = true;
        lb!.setAttribute('aria-hidden', 'true');
      };
      const onEnd = (e: TransitionEvent) => { if (e.target === lb) finish(); };
      lb!.addEventListener('transitionend', onEnd);
      setTimeout(finish, 320);
      if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
    }

    function nav(key: string) {
      const h = activeHoriz();
      if (key === 'Escape') close();
      else if (key === 'ArrowLeft') h && h.slidePrev();
      else if (key === 'ArrowRight') h && h.slideNext();
      else if (key === 'ArrowUp') goProject(-1);
      else if (key === 'ArrowDown') goProject(1);
    }

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => { const h = activeHoriz(); h && h.slidePrev(); });
    nextBtn.addEventListener('click', () => { const h = activeHoriz(); h && h.slideNext(); });
    // One Previous-project control per slide (all but the first project), centred
    // above that slide's image; they all drive the same jump.
    lb.querySelectorAll('.lb-up').forEach((b) => b.addEventListener('click', () => goProject(-1)));
    downBtn.addEventListener('click', () => goProject(1));

    // Click on empty space closes; media (incl. the Plyr player chrome), header,
    // counter, and controls don't.
    lb.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('.lb-media, .plyr, .lb-phead, .lb-pcount, button')) return;
      close();
    });

    current = { el: lb, open, close, nav };

    // Auto-repro (debug): open the first project, then swap projects down-to-end / back-up on a
    // 420ms timer (faster than the 480ms glide, so the animated transitions overlap the way rapid
    // manual swiping does). Hands-free crash repro; each transition is logged with the counters.
    // Suppressed on a crash-recovery load so the painted trail can be read.
    if (LB_DEBUG && LB_AUTODRIVE && !lbRecovered && !autodriveRan) {
      autodriveRan = true;
      const slugs = projects().map((s) => s.dataset.slug || '');
      lbMark('AUTODRIVE-START');
      open(slugs[0], 0);
      let dir = 1;
      const tick = () => {
        if (!current || current.el.hidden) return;          // lightbox actually closed -> stop
        if (!vert) { setTimeout(tick, 200); return; }       // Swiper not ready yet -> retry, don't give up
        if (vert.isEnd) dir = -1; else if (vert.isBeginning) dir = 1;
        lbMark('auto:' + (dir > 0 ? 'down' : 'up') + ':idx' + vert.activeIndex);
        nav(dir > 0 ? 'ArrowDown' : 'ArrowUp');
        setTimeout(tick, 420);
      };
      setTimeout(tick, 900);
    }
  }

  // ── Document-level wiring (bound once; persists across view transitions) ──
  let docBound = false;
  function bindDoc() {
    if (docBound) return;
    docBound = true;

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.shot') as HTMLElement | null;
      if (!btn || !current) return;
      e.preventDefault();
      current.open(btn.dataset.project || '', parseInt(btn.dataset.index || '0', 10));
    });

    document.addEventListener('keydown', (e) => {
      if (!current || current.el.hidden) return;
      // While a video is fullscreen, the browser/Plyr owns the keyboard (Esc exits
      // fullscreen, not the gallery; arrows seek). Stand down until it exits.
      if (document.fullscreenElement) return;
      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Escape'].includes(e.key)) {
        e.preventDefault();
        current.nav(e.key);
      }
    });
  }

  document.addEventListener('astro:before-swap', destroyInstances);
  // lbRecoverTrail BEFORE setupLightbox: paint any crash trail and set lbRecovered so autodrive
  // stands down on the recovery load (no re-crash before you can read it).
  document.addEventListener('astro:page-load', () => { lbRecoverTrail(); bindDoc(); setupLightbox(); });
  lbRecoverTrail();
  bindDoc();
  setupLightbox();
</script>

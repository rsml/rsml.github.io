---
interface Props { thumbClass: string; image?: string; }
const { thumbClass, image } = Astro.props;
---
<div class:list={["thumb", thumbClass]}>
  {image && <img class="thumb-icon" src={image} alt="" loading="lazy" />}
</div>
<style>
  /* Square app-icon tile. The icon image fills the tile edge-to-edge and the
     tile's border-radius clips every source icon — full-bleed art (vivy,
     symphony, text2order) or a squircle sitting on its own matte/light corners
     (chord, tutor, forge) — to one uniform rounded-app-icon silhouette. Because
     each icon carries its own field, the tile needs no background of its own. */
  .thumb {
    aspect-ratio: 1 / 1;
    width: 64px;
    border-radius: 23%;
    overflow: hidden;
    position: relative;
    transition: transform 180ms ease;
  }
  .thumb img.thumb-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Tutor's source icon draws the book with extra macOS-style padding, so its
     artwork reads smaller than the others (it fills ~63% vs ~80% for Chord).
     Zoom it in to match their visual weight; the zoom also crops the light
     squircle corners, leaving a clean black field. */
  .thumb-tutor .thumb-icon { transform: scale(1.25); }
</style>

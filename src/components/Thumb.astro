---
interface Props { thumbClass: string; image?: string; }
const { thumbClass, image } = Astro.props;
---
<div class:list={["thumb", thumbClass]}>
  {image && <img class="thumb-icon" src={image} alt="" loading="lazy" />}
</div>
<style>
  /* Square app-icon tile. Every source icon is full-bleed app art on its own
     field (no padding, border, or liquid-glass treatment), so the image fills
     the tile edge-to-edge and the tile's border-radius clips it to one uniform
     rounded-app-icon silhouette. The tile needs no background of its own
     because each icon carries its own field. */
  .thumb {
    aspect-ratio: 1 / 1;
    width: 64px;
    border-radius: 23%;
    overflow: hidden;
    position: relative;
    transition: transform 180ms ease;
  }
  .thumb img.thumb-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

---
import Caption from '../content/Caption.astro';
---
<p class="color-wheel-title">The Circle of Fifths with my colors added</p>
<div class="color-wheel-demo">
  <svg viewBox="0 0 400 400" role="img" aria-label="Circle of Fifths with neighboring notes connected by OKLCH-uniform gradients">
    <!-- 12 neighbor gradients. Intermediate stops are computed along the OKLCH path
         and converted back to sRGB hex so what the browser renders matches the math
         exactly (no oklch() gamut clipping). Generated by oklch_gradients.py. -->
    <defs>
      <linearGradient id="nb-c-g" x1="200" y1="50" x2="275" y2="70" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#FF0000"/>
        <stop offset="14.3%"  stop-color="#FF1D00"/>
        <stop offset="28.6%"  stop-color="#FF2C00"/>
        <stop offset="42.9%"  stop-color="#FF3800"/>
        <stop offset="57.1%"  stop-color="#FF4100"/>
        <stop offset="71.4%"  stop-color="#FF4A00"/>
        <stop offset="85.7%"  stop-color="#FF5200"/>
        <stop offset="100.0%" stop-color="#FF5900"/>
      </linearGradient>
      <linearGradient id="nb-g-d" x1="275" y1="70" x2="330" y2="125" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#FF5900"/>
        <stop offset="14.3%"  stop-color="#FF6200"/>
        <stop offset="28.6%"  stop-color="#FF6A00"/>
        <stop offset="42.9%"  stop-color="#FF7200"/>
        <stop offset="57.1%"  stop-color="#FF7900"/>
        <stop offset="71.4%"  stop-color="#FF8100"/>
        <stop offset="85.7%"  stop-color="#FF8800"/>
        <stop offset="100.0%" stop-color="#FF8F00"/>
      </linearGradient>
      <linearGradient id="nb-d-a" x1="330" y1="125" x2="350" y2="200" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#FF8F00"/>
        <stop offset="14.3%"  stop-color="#FF9600"/>
        <stop offset="28.6%"  stop-color="#FF9E00"/>
        <stop offset="42.9%"  stop-color="#FFA600"/>
        <stop offset="57.1%"  stop-color="#FFAD00"/>
        <stop offset="71.4%"  stop-color="#FFB500"/>
        <stop offset="85.7%"  stop-color="#FFBC00"/>
        <stop offset="100.0%" stop-color="#FFC400"/>
      </linearGradient>
      <linearGradient id="nb-a-e" x1="350" y1="200" x2="330" y2="275" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#FFC400"/>
        <stop offset="14.3%"  stop-color="#FFCC00"/>
        <stop offset="28.6%"  stop-color="#FFD400"/>
        <stop offset="42.9%"  stop-color="#FFDC00"/>
        <stop offset="57.1%"  stop-color="#FFE500"/>
        <stop offset="71.4%"  stop-color="#FFED00"/>
        <stop offset="85.7%"  stop-color="#FFF600"/>
        <stop offset="100.0%" stop-color="#FEFF00"/>
      </linearGradient>
      <linearGradient id="nb-e-b" x1="330" y1="275" x2="275" y2="330" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#FEFF00"/>
        <stop offset="14.3%"  stop-color="#ECF800"/>
        <stop offset="28.6%"  stop-color="#D9F100"/>
        <stop offset="42.9%"  stop-color="#C7E900"/>
        <stop offset="57.1%"  stop-color="#B4E200"/>
        <stop offset="71.4%"  stop-color="#A1DA00"/>
        <stop offset="85.7%"  stop-color="#8DD300"/>
        <stop offset="100.0%" stop-color="#78CB00"/>
      </linearGradient>
      <linearGradient id="nb-b-fs" x1="275" y1="330" x2="200" y2="350" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#78CB00"/>
        <stop offset="14.3%"  stop-color="#6EC700"/>
        <stop offset="28.6%"  stop-color="#63C400"/>
        <stop offset="42.9%"  stop-color="#57C000"/>
        <stop offset="57.1%"  stop-color="#4ABD00"/>
        <stop offset="71.4%"  stop-color="#3BB900"/>
        <stop offset="85.7%"  stop-color="#28B600"/>
        <stop offset="100.0%" stop-color="#00B200"/>
      </linearGradient>
      <linearGradient id="nb-fs-cs" x1="200" y1="350" x2="125" y2="330" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#00B200"/>
        <stop offset="14.3%"  stop-color="#00B550"/>
        <stop offset="28.6%"  stop-color="#00B675"/>
        <stop offset="42.9%"  stop-color="#00B591"/>
        <stop offset="57.1%"  stop-color="#00B3A7"/>
        <stop offset="71.4%"  stop-color="#00AFB8"/>
        <stop offset="85.7%"  stop-color="#00AAC4"/>
        <stop offset="100.0%" stop-color="#00A5CB"/>
      </linearGradient>
      <linearGradient id="nb-cs-gs" x1="125" y1="330" x2="70" y2="275" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#00A5CB"/>
        <stop offset="14.3%"  stop-color="#009CCA"/>
        <stop offset="28.6%"  stop-color="#0093C8"/>
        <stop offset="42.9%"  stop-color="#008AC6"/>
        <stop offset="57.1%"  stop-color="#0081C4"/>
        <stop offset="71.4%"  stop-color="#0077C1"/>
        <stop offset="85.7%"  stop-color="#006DBE"/>
        <stop offset="100.0%" stop-color="#0063BB"/>
      </linearGradient>
      <linearGradient id="nb-gs-ds" x1="70" y1="275" x2="50" y2="200" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#0063BB"/>
        <stop offset="14.3%"  stop-color="#005AB9"/>
        <stop offset="28.6%"  stop-color="#0050B7"/>
        <stop offset="42.9%"  stop-color="#0046B5"/>
        <stop offset="57.1%"  stop-color="#003BB3"/>
        <stop offset="71.4%"  stop-color="#002EB1"/>
        <stop offset="85.7%"  stop-color="#001EAF"/>
        <stop offset="100.0%" stop-color="#0800AC"/>
      </linearGradient>
      <linearGradient id="nb-ds-as" x1="50" y1="200" x2="70" y2="125" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#0800AC"/>
        <stop offset="14.3%"  stop-color="#2100AF"/>
        <stop offset="28.6%"  stop-color="#3100B2"/>
        <stop offset="42.9%"  stop-color="#3F00B3"/>
        <stop offset="57.1%"  stop-color="#4B00B2"/>
        <stop offset="71.4%"  stop-color="#5700B1"/>
        <stop offset="85.7%"  stop-color="#6300AF"/>
        <stop offset="100.0%" stop-color="#6E00AC"/>
      </linearGradient>
      <linearGradient id="nb-as-f" x1="70" y1="125" x2="125" y2="70" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#6E00AC"/>
        <stop offset="14.3%"  stop-color="#7E00AA"/>
        <stop offset="28.6%"  stop-color="#8D00A6"/>
        <stop offset="42.9%"  stop-color="#9D00A1"/>
        <stop offset="57.1%"  stop-color="#AC009B"/>
        <stop offset="71.4%"  stop-color="#BB0093"/>
        <stop offset="85.7%"  stop-color="#C9008A"/>
        <stop offset="100.0%" stop-color="#D7007F"/>
      </linearGradient>
      <linearGradient id="nb-f-c" x1="125" y1="70" x2="200" y2="50" gradientUnits="userSpaceOnUse">
        <stop offset="0.0%"   stop-color="#D7007F"/>
        <stop offset="14.3%"  stop-color="#DE0075"/>
        <stop offset="28.6%"  stop-color="#E5006A"/>
        <stop offset="42.9%"  stop-color="#EB005E"/>
        <stop offset="57.1%"  stop-color="#F10050"/>
        <stop offset="71.4%"  stop-color="#F60040"/>
        <stop offset="85.7%"  stop-color="#FB002C"/>
        <stop offset="100.0%" stop-color="#FF0000"/>
      </linearGradient>
    </defs>
    <line x1="200" y1="50"  x2="275" y2="70"  stroke="url(#nb-c-g)"   stroke-width="3" stroke-linecap="round"/>
    <line x1="275" y1="70"  x2="330" y2="125" stroke="url(#nb-g-d)"   stroke-width="3" stroke-linecap="round"/>
    <line x1="330" y1="125" x2="350" y2="200" stroke="url(#nb-d-a)"   stroke-width="3" stroke-linecap="round"/>
    <line x1="350" y1="200" x2="330" y2="275" stroke="url(#nb-a-e)"   stroke-width="3" stroke-linecap="round"/>
    <line x1="330" y1="275" x2="275" y2="330" stroke="url(#nb-e-b)"   stroke-width="3" stroke-linecap="round"/>
    <line x1="275" y1="330" x2="200" y2="350" stroke="url(#nb-b-fs)"  stroke-width="3" stroke-linecap="round"/>
    <line x1="200" y1="350" x2="125" y2="330" stroke="url(#nb-fs-cs)" stroke-width="3" stroke-linecap="round"/>
    <line x1="125" y1="330" x2="70"  y2="275" stroke="url(#nb-cs-gs)" stroke-width="3" stroke-linecap="round"/>
    <line x1="70"  y1="275" x2="50"  y2="200" stroke="url(#nb-gs-ds)" stroke-width="3" stroke-linecap="round"/>
    <line x1="50"  y1="200" x2="70"  y2="125" stroke="url(#nb-ds-as)" stroke-width="3" stroke-linecap="round"/>
    <line x1="70"  y1="125" x2="125" y2="70"  stroke="url(#nb-as-f)"  stroke-width="3" stroke-linecap="round"/>
    <line x1="125" y1="70"  x2="200" y2="50"  stroke="url(#nb-f-c)"   stroke-width="3" stroke-linecap="round"/>
    <!-- 12 notes, C at top, stepping 30° clockwise. Original palette hex (no border). -->
    <circle class="note-circle" cx="200" cy="50"  r="34" fill="#FF0000" />
    <text   class="note-label"  x="200" y="50" fill="#fff">C</text>
    <circle class="note-circle" cx="275" cy="70"  r="34" fill="#FF5900" />
    <text   class="note-label"  x="275" y="70" fill="#fff">G</text>
    <circle class="note-circle" cx="330" cy="125" r="34" fill="#FF8F00" />
    <text   class="note-label"  x="330" y="125" fill="#111">D</text>
    <circle class="note-circle" cx="350" cy="200" r="34" fill="#FFC400" />
    <text   class="note-label"  x="350" y="200" fill="#111">A</text>
    <circle class="note-circle" cx="330" cy="275" r="34" fill="#FEFF00" />
    <text   class="note-label"  x="330" y="275" fill="#111">E</text>
    <circle class="note-circle" cx="275" cy="330" r="34" fill="#78CB00" />
    <text   class="note-label"  x="275" y="330" fill="#111">B</text>
    <circle class="note-circle" cx="200" cy="350" r="34" fill="#00B200" />
    <text   class="note-label"  x="200" y="350" fill="#111">F&#9839;</text>
    <circle class="note-circle" cx="125" cy="330" r="34" fill="#00A5CB" />
    <text   class="note-label"  x="125" y="330" fill="#111">C&#9839;</text>
    <circle class="note-circle" cx="70"  cy="275" r="34" fill="#0063BB" />
    <text   class="note-label"  x="70"  y="275" fill="#fff">G&#9839;</text>
    <circle class="note-circle" cx="50"  cy="200" r="34" fill="#0800AC" />
    <text   class="note-label"  x="50"  y="200" fill="#fff">D&#9839;</text>
    <circle class="note-circle" cx="70"  cy="125" r="34" fill="#6E00AC" />
    <text   class="note-label"  x="70"  y="125" fill="#fff">A&#9839;</text>
    <circle class="note-circle" cx="125" cy="70"  r="34" fill="#D7007F" />
    <text   class="note-label"  x="125" y="70" fill="#fff">F</text>
  </svg>
</div>
<Caption>Neighbors are a perfect fifth apart, the most consonant interval in music.</Caption>

<p class="color-wheel-title">Tritones</p>
<div class="color-wheel-demo">
  <svg viewBox="0 0 400 400" role="img" aria-label="Tritone pairs shown as solid-color dashed lines with a one-missing-dash gap at the wheel center">
    <!-- Each note projects a solid-color dashed line toward the wheel center.
         Dash pattern L=20, G=15, n=4 dashes per line, line length 125. Lines stop
         25 units short of (200, 200), so each pair of opposite notes leaves a
         50-unit center gap = L + 2G, visually "one missing dash" flanked by
         normal gaps. No fading, no gradients. Computed by oklch_gradients.py. -->
    <line x1="200" y1="50"  x2="200.00" y2="175.00" stroke="#FF0000" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="275" y1="70"  x2="212.50" y2="178.33" stroke="#FF5900" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="330" y1="125" x2="221.67" y2="187.50" stroke="#FF8F00" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="350" y1="200" x2="225.00" y2="200.00" stroke="#FFC400" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="330" y1="275" x2="221.67" y2="212.50" stroke="#FEFF00" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="275" y1="330" x2="212.50" y2="221.67" stroke="#78CB00" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="200" y1="350" x2="200.00" y2="225.00" stroke="#00B200" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="125" y1="330" x2="187.50" y2="221.67" stroke="#00A5CB" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="70"  y1="275" x2="178.33" y2="212.50" stroke="#0063BB" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="50"  y1="200" x2="175.00" y2="200.00" stroke="#0800AC" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="70"  y1="125" x2="178.33" y2="187.50" stroke="#6E00AC" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <line x1="125" y1="70"  x2="187.50" y2="178.33" stroke="#D7007F" stroke-width="3" stroke-dasharray="20 15" stroke-linecap="round"/>
    <!-- 12 notes, original palette hex, no border. -->
    <circle class="note-circle" cx="200" cy="50"  r="34" fill="#FF0000" />
    <text   class="note-label"  x="200" y="50" fill="#fff">C</text>
    <circle class="note-circle" cx="275" cy="70"  r="34" fill="#FF5900" />
    <text   class="note-label"  x="275" y="70" fill="#fff">G</text>
    <circle class="note-circle" cx="330" cy="125" r="34" fill="#FF8F00" />
    <text   class="note-label"  x="330" y="125" fill="#111">D</text>
    <circle class="note-circle" cx="350" cy="200" r="34" fill="#FFC400" />
    <text   class="note-label"  x="350" y="200" fill="#111">A</text>
    <circle class="note-circle" cx="330" cy="275" r="34" fill="#FEFF00" />
    <text   class="note-label"  x="330" y="275" fill="#111">E</text>
    <circle class="note-circle" cx="275" cy="330" r="34" fill="#78CB00" />
    <text   class="note-label"  x="275" y="330" fill="#111">B</text>
    <circle class="note-circle" cx="200" cy="350" r="34" fill="#00B200" />
    <text   class="note-label"  x="200" y="350" fill="#111">F&#9839;</text>
    <circle class="note-circle" cx="125" cy="330" r="34" fill="#00A5CB" />
    <text   class="note-label"  x="125" y="330" fill="#111">C&#9839;</text>
    <circle class="note-circle" cx="70"  cy="275" r="34" fill="#0063BB" />
    <text   class="note-label"  x="70"  y="275" fill="#fff">G&#9839;</text>
    <circle class="note-circle" cx="50"  cy="200" r="34" fill="#0800AC" />
    <text   class="note-label"  x="50"  y="200" fill="#fff">D&#9839;</text>
    <circle class="note-circle" cx="70"  cy="125" r="34" fill="#6E00AC" />
    <text   class="note-label"  x="70"  y="125" fill="#fff">A&#9839;</text>
    <circle class="note-circle" cx="125" cy="70"  r="34" fill="#D7007F" />
    <text   class="note-label"  x="125" y="70" fill="#fff">F</text>
  </svg>
</div>
<Caption>Notes opposite each other (aka "tritones") on the Circle of Fifths sound most dissonant.</Caption>
<style>
  .color-wheel-demo {
    margin: 8px 0 6px;
    padding: 28px;
    background: #fcfcfc;
    border: 1px solid var(--hair);
    border-radius: 10px;
    display: flex;
    justify-content: center;
  }
  .color-wheel-demo svg {
    width: 380px;
    height: 380px;
    max-width: 100%;
    display: block;
  }
  .color-wheel-demo .note-label {
    font-family: "Inter var", "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 22px;
    text-anchor: middle;
    dominant-baseline: central;
    alignment-baseline: central;
    text-rendering: geometricPrecision;
    user-select: none;
    pointer-events: none;
  }
  .color-wheel-title {
    margin: 24px 0 8px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.1px;
  }
</style>

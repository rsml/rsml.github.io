---
/*
 * GuardrailFlow: the whole framework as one exhaustive map.
 *
 * Every automated way to catch a bug is one of three, reached by two binary,
 * first-principles questions:
 *   1. Can a check catch it without running the code?  no  -> Runtime
 *   2. Can it slip past a lint rule?
 *        no, caught -> Scanner (a lint rule)
 *        yes, slips -> Type system (the bug cannot be written)
 * That is the complete partition: run it / scan it / type it. The specific
 * cases the essay covers (sensitive data, error channels, dependencies) are
 * instances that live inside the Type-system box; Effect is just a way to put
 * more into the type, not a fourth destination.
 *
 * Drawn in SVG so connectors are computed from box edges and actually touch.
 * Monochrome on purpose: the three are peers sorted by the questions, so there
 * is nothing to colour-code. Each destination links to the section that zooms
 * into it (Astro auto-generates the heading ids).
 */
import '../guardrail-tiers.css';

const L1 = '#runtime-caught-when-it-runs';
const L2 = '#scanner-caught-before-it-runs';
const L3 = '#type-system-the-bug-cannot-be-written';

type Box = {
  cx: number; cy: number; w: number; h: number;
  role: 'start' | 'decision' | 'dest';
  title: string[];
  sub?: string;
  href?: string;
};

const N: Record<string, Box> = {
  bug:     { cx: 168, cy: 40,  w: 162, h: 42, role: 'start',    title: ['A class of bug'] },
  q1:      { cx: 168, cy: 144, w: 210, h: 58, role: 'decision', title: ['Catchable without', 'running the code?'] },
  runtime: { cx: 460, cy: 144, w: 200, h: 64, role: 'dest', title: ['Runtime'], sub: 'catch it by running', href: L1 },
  q2:      { cx: 168, cy: 256, w: 210, h: 58, role: 'decision', title: ['Can it slip past', 'a lint rule?'] },
  scanner: { cx: 460, cy: 256, w: 200, h: 64, role: 'dest', title: ['Scanner'], sub: 'a lint rule, with holes', href: L2 },
  type:    { cx: 460, cy: 370, w: 200, h: 64, role: 'dest', title: ['Type system'], sub: "the bug can't be written", href: L3 },
};

const VBW = 600;
const VBH = 424;

const ed = (n: Box) => ({ l: n.cx - n.w / 2, r: n.cx + n.w / 2, t: n.cy - n.h / 2, b: n.cy + n.h / 2 });
const E = Object.fromEntries(Object.entries(N).map(([k, n]) => [k, ed(n)])) as Record<string, ReturnType<typeof ed>>;

// Connectors. Each ends on a box edge; marker-end draws the arrow.
const paths = [
  `M168 ${E.bug.b} L168 ${E.q1.t}`,                          // bug -> q1
  `M${E.q1.r} 144 L${E.runtime.l} 144`,                      // q1 -> runtime (no)
  `M168 ${E.q1.b} L168 ${E.q2.t}`,                           // q1 -> q2 (yes)
  `M${E.q2.r} 256 L${E.scanner.l} 256`,                      // q2 -> scanner (holes)
  `M168 ${E.q2.b} L168 370 L${E.type.l} 370`,                // q2 -> type (airtight), elbow
];

const elabels = [
  { x: (E.q1.r + E.runtime.l) / 2, y: 135, t: 'no', a: 'middle' },
  { x: 178, y: 200, t: 'yes', a: 'start' },
  { x: (E.q2.r + E.scanner.l) / 2, y: 247, t: 'no', a: 'middle' },
  { x: 178, y: 320, t: 'yes', a: 'start' },
];

function texts(n: Box) {
  const out: { x: number; y: number; cls: string; text: string }[] = [];
  if (n.role === 'start') {
    out.push({ x: n.cx, y: n.cy + 4, cls: 'ff-t-start', text: n.title[0] });
  } else if (n.role === 'decision') {
    out.push({ x: n.cx, y: n.cy - 7, cls: 'ff-t-q', text: n.title[0] });
    out.push({ x: n.cx, y: n.cy + 12, cls: 'ff-t-q', text: n.title[1] ?? '' });
  } else {
    out.push({ x: n.cx, y: n.cy - 4, cls: 'ff-t-title', text: n.title[0] });
    if (n.sub) out.push({ x: n.cx, y: n.cy + 16, cls: 'ff-t-sub', text: n.sub });
  }
  return out;
}

const boxes = Object.entries(N).map(([id, n]) => ({
  id, role: n.role, href: n.href,
  x: n.cx - n.w / 2, y: n.cy - n.h / 2, w: n.w, h: n.h,
  texts: texts(n),
}));
---

<figure class="gg-root gg-flow" role="group" aria-label="The three places a bug can be caught">
  <div class="ff-scroll">
    <svg class="ff-svg" viewBox={`0 0 ${VBW} ${VBH}`} role="img"
         aria-label="Two questions sort any bug into one of three places it can be caught: runtime, a scanner, or the type system.">
      <defs>
        <marker id="ff-arrow" viewBox="0 0 10 10" refX="8.5" refY="5"
                markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path class="ff-arrowhead" d="M0 0 L10 5 L0 10 z" />
        </marker>
      </defs>

      {paths.map((d) => (
        <path class="ff-edge" d={d} marker-end="url(#ff-arrow)" />
      ))}

      {elabels.map((l) => (
        <text class="ff-elabel" x={l.x} y={l.y} text-anchor={l.a}>{l.t}</text>
      ))}

      {boxes.map((b) => {
        const inner = (
          <Fragment>
            <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="8" />
            {b.texts.map((t) => (
              <text class={t.cls} x={t.x} y={t.y} text-anchor="middle">{t.text}</text>
            ))}
          </Fragment>
        );
        return b.href ? (
          <a class={`ff-box ff-${b.role}`} href={b.href}>{inner}</a>
        ) : (
          <g class={`ff-box ff-${b.role}`}>{inner}</g>
        );
      })}
    </svg>
  </div>

  <figcaption class="gg-caption">
    Three places to catch a bug, sorted by two questions. Run it, scan it, or put it in the type.
    Tap a box to jump to that section.
  </figcaption>
</figure>

<style>
  .gg-flow {
    font-family: 'Inter var', system-ui, -apple-system, sans-serif;
    width: calc(100% + 48px);
    margin: 2rem -24px;
    --ff-line: var(--gg-muted);
  }
  .ff-scroll {
    overflow-x: auto;
    padding: 0 24px;
    -webkit-overflow-scrolling: touch;
  }
  .ff-svg {
    display: block;
    width: 100%;
    min-width: 520px;
    max-width: 620px;
    height: auto;
    margin: 0 auto;
  }

  /* connectors */
  .ff-edge { fill: none; stroke: var(--ff-line); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ff-arrowhead { fill: var(--ff-line); }
  .ff-elabel {
    fill: var(--gg-muted);
    font-family: var(--gg-mono);
    font-size: 11px;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  /* boxes: monochrome. decisions are filled and questioning; destinations are
     outlined with a bold name. No hue coding. */
  .ff-box rect {
    fill: var(--gg-panel);
    stroke: var(--gg-border);
    stroke-width: 1.4;
    transition: stroke 0.15s ease, stroke-width 0.15s ease, fill 0.15s ease;
  }
  .ff-box text { pointer-events: none; }
  a.ff-box { cursor: pointer; text-decoration: none; }
  a.ff-box:hover rect { fill: var(--gg-panel-2); stroke: var(--gg-text); stroke-width: 2; }
  a.ff-box:focus-visible rect { stroke: var(--gg-text); stroke-width: 2.2; }

  .ff-start rect { fill: var(--gg-panel-2); }
  .ff-decision rect { fill: var(--gg-panel-2); stroke: var(--gg-muted); stroke-width: 1.6; }

  .ff-t-start { fill: var(--gg-muted); font-size: 13px; font-weight: 600; letter-spacing: -0.01em; }
  .ff-t-q { fill: var(--gg-text); font-size: 13.5px; font-weight: 560; letter-spacing: -0.01em; }
  .ff-t-title { fill: var(--gg-text); font-size: 14px; font-weight: 600; letter-spacing: -0.01em; }
  .ff-t-sub { fill: var(--gg-muted); font-family: var(--gg-mono); font-size: 10.5px; }

  @media (max-width: 520px) {
    .ff-scroll { padding: 0 16px; }
  }
</style>

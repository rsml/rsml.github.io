---
import BaseHead from '../components/BaseHead.astro';
import RippleCanvas from '../components/RippleCanvas.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import '../styles/global.css';
interface Props { title: string; description?: string; ogImage?: string; }
const { title, description, ogImage } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <div class="top-blur" aria-hidden="true"></div>
    <div class="crt-overlay" aria-hidden="true"></div>
    <script>
      import '../scripts/transitions.ts';
    </script>
    <RippleCanvas />
  </body>
</html>

---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import BackLink from '../../components/BackLink.astro';
import MarketingButton from '../../components/MarketingButton.astro';
import { existsSync } from 'node:fs';
import { WORK, getProject } from '../../data/work';
import { logoPath, logoPath1x } from '../../../tools/optimize-portfolio.mjs';
import { avifSourceFor } from '../../lib/pictureSource';

import ChordColors from '../../components/work/ChordColors.astro';
import Tutor from '../../components/work/Tutor.astro';
import Forge from '../../components/work/Forge.astro';
import Symphony from '../../components/work/Symphony.astro';
import Openpath from '../../components/work/Openpath.astro';
import Sms from '../../components/work/Sms.astro';
import Vivy from '../../components/work/Vivy.astro';

const bodies: Record<string, any> = {
  'chord-colors': ChordColors, tutor: Tutor, forge: Forge, symphony: Symphony,
  openpath: Openpath, sms: Sms, vivy: Vivy,
};

// `deepDive` is the single gate for a case study existing. It already controls
// the "Deep dive" link on the home row and in the lightbox, so gating the route
// on it too means a page can never be built without a way to reach it. The
// other bodies stay wired up in `bodies` above, so finishing a case study is
// just setting `deepDive: true` in work.yaml.
export function getStaticPaths() {
  return WORK.filter((p) => p.deepDive).map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const project = getProject(slug!)!;
const Body = bodies[project.slug];

function resolveLogoSrcs(src: string): { src: string; srcset?: string } {
  if (!src.startsWith('/')) return { src };
  const logo2x = logoPath(src);
  if (existsSync(`${process.cwd()}/public${logo2x}`)) {
    const logo1x = logoPath1x(src);
    const has1x = existsSync(`${process.cwd()}/public${logo1x}`);
    return {
      src: has1x ? logo1x : logo2x,
      srcset: has1x ? `${logo1x} 1x, ${logo2x} 2x` : undefined,
    };
  }
  return { src };
}
const logoSrcs = project.thumbImage ? resolveLogoSrcs(project.thumbImage) : null;
const logoAvif = logoSrcs ? avifSourceFor(logoSrcs.src, logoSrcs.srcset) : null;
---
<PortfolioLayout title={`${project.title} - Ross Miller`} description={project.cardDesc} ogImage={`/og/craft-${project.slug}.png`}>
  <main class="container dive" data-rise>
    <div class="rise-slot top-row" style="--rise-i:0">
      <BackLink />
      {project.marketingUrl && <MarketingButton href={project.marketingUrl} label={project.marketingLabel ?? 'Visit site'} />}
    </div>
    <div class="dive-header" style="--rise-i:1">
      {project.thumbImage && (
        <span class:list={['dive-logo', project.thumbClass]}>
          <picture>
            {logoAvif && <source type="image/avif" srcset={logoAvif} />}
            <img src={logoSrcs!.src} srcset={logoSrcs!.srcset} alt="" width="48" height="48" />
          </picture>
        </span>
      )}
      <div class="dive-heading">
        <h1 class="dive-title">
          <span class="dive-name">{project.cardTitle}</span>
          <span class="dive-sub">{project.subtitle}</span>
        </h1>
        <p class="dive-role">{project.role}</p>
      </div>
      {project.appStoreUrl && (
        <a class="appstore-badge" href={project.appStoreUrl} target="_blank" rel="noopener">
          <img src="/badges/download-on-the-app-store-white.svg" alt="Download on the App Store" width="120" height="40" />
        </a>
      )}
    </div>
    {project.links && project.links.length > 0 && (
      <div class="dive-links" style="--rise-i:2">
        {project.links.map((link: { label: string; href: string }) => {
          const external = /^https?:/.test(link.href);
          return external
            ? <a class="dive-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg><span class="sr-only">(opens in a new tab)</span></a>
            : <a class="dive-link" href={link.href} data-astro-reload>{link.label}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>;
        })}
      </div>
    )}
    <div class="dive-body case-body" style="--rise-i:3"><Body /></div>
  </main>
</PortfolioLayout>
<style>
  .container.dive { position: relative; }
  /* Back link left, marketing button right, one flex row. Flex (not absolute
     positioning) keeps each link's hit area exactly its own box: the rise
     animation's retained transform turns each .rise-slot into a containing
     block + stacking context, which made an absolutely-positioned button land
     under the block-level back link's full-width hit area (clicks went home). */
  .top-row { display: flex; align-items: center; justify-content: space-between; margin: 0 0 32px; }
  /* Echoes the gallery lightbox header (see Lightbox.astro's .lb-phead) in the
     case study's light theme, but stacks the subtitle under the name instead of
     running it inline after a colon. */
  .dive-header { display: flex; align-items: center; gap: 12px; margin: 0 0 32px; }
  /* Square app-icon tile: inner <img> fills it; overflow:hidden + radius clip
     every source icon to one silhouette. No rim/border (owner preference); a
     soft shadow alone lifts the tile off the white page. */
  .dive-logo {
    flex: none;
    width: 48px; height: 48px;
    border-radius: 22%;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(17, 17, 17, 0.10);
  }
  .dive-logo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dive-heading { min-width: 0; }
  .dive-title {
    margin: 0;
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .dive-name { display: block; font-weight: 600; color: var(--ink); }
  .dive-sub  { display: block; font-weight: 460; color: var(--muted); }
  .dive-role { margin: 1px 0 0; color: var(--muted); font-size: 12.5px; }
  /* Official Apple "Download on the App Store" badge (white variant), right-aligned
     past a flex spacer. Badge artwork is the unmodified official SVG. */
  .appstore-badge { margin-left: auto; flex: none; line-height: 0; transition: opacity 160ms ease; }
  .appstore-badge:hover { opacity: 0.7; }
  .appstore-badge img { display: block; height: 40px; width: auto; }
  .dive-links { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 32px; }
  .dive-link {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 13px; color: var(--ink); text-decoration: none;
    border: 1px solid var(--hair); border-radius: 999px; padding: 6px 14px;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .dive-link:hover { border-color: var(--hairHigh); background: rgba(17,17,17,0.025); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .dive-body p { margin: 0 0 20px; }
  .case-body p { margin: 0 0 14px; max-width: 62ch; }
  .case-body code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 12.5px;
    background: rgb(244, 244, 244);
    border-radius: 4px;
    padding: 1px 6px;
    color: var(--ink);
  }
  /* Match the rest of the page: hairline underline, fills to ink on hover. */
  .case-body a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--hairHigh), var(--hairHigh));
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 1px;
    transition: background-image 200ms ease;
  }
  .case-body a:hover {
    background-image: linear-gradient(var(--ink), var(--ink));
  }
</style>

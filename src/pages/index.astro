---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import Lightbox from '../components/Lightbox.astro';
import NowClock from '../components/NowClock.astro';
import { getWork } from '../data/work';
const work = getWork();
---
<PortfolioLayout title="Ross Miller">
  <main class="container" data-rise>
    <h1 class="name" style="--rise-i:0; --rise-fn:focusIn; animation-duration:var(--hero-blur-dur,1.5s)">Ross Miller</h1>
    <p class="title" style="--rise-i:0; --rise-fn:focusIn; animation-duration:var(--hero-blur-dur,1.5s)">Developer, designer, 4x founder</p>
    <div class="bio" style="--rise-i:0">
      <p>I lead with empathy, level up the people around me, build things that matter, and care deeply about craft.</p>

      <p>You can find me on <a href="https://www.linkedin.com/in/rossnmiller/" target="_blank" rel="noopener noreferrer">LinkedIn</a>, <a href="https://github.com/rsml" target="_blank" rel="noopener noreferrer">GitHub</a>, <a href="https://x.com/coding_ross" target="_blank" rel="noopener noreferrer">X</a>, or reach me via <a href="mailto:rossnmiller@gmail.com">email</a>.</p>
    </div>
    <h2 class="home-section-h" style="--rise-i:0; --rise-base:1000ms">Selected works</h2>
    <div class="work" style="--rise-i:1; --rise-base:1000ms">
      {work.map((p, i) => <WorkRow project={p} eager={i === 0} />)}
    </div>
    <NowClock style="--rise-i:2; --rise-base:1000ms" />
  </main>
  <Lightbox projects={work} />
</PortfolioLayout>
<style>
  h1.name { margin: 0 0 2px; padding-top: 30px; font-size: 14px; font-weight: 500; }
  .title { margin: 0; color: var(--muted); }
  .bio { margin: 40px 0 50px; }
  .bio p { margin: 0 0 12px; }
  .bio p:last-child { margin-bottom: 0; }
  /* Same treatment as the work links: a quiet underline at rest that fills to
     full ink on hover. text-decoration-color animates (background-image can't),
     so the fill is a smooth fade, not a snap. */
  .bio a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--ink) 22%, transparent);
    transition: text-decoration-color 200ms ease;
  }
  .bio a:hover { text-decoration-color: var(--ink); }
  h2.home-section-h { margin: 0 0 4px; font-size: 14px; font-weight: 460; color: var(--muted); }
  .work { margin: 0; }
</style>

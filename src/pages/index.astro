---
import { existsSync } from 'node:fs';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import Lightbox from '../components/Lightbox.astro';
import NowClock from '../components/NowClock.astro';
import { getCollection } from 'astro:content';
import { getWork } from '../data/work';
import { thumbPath, thumbPath1x } from '../../tools/optimize-portfolio.mjs';
import { avifSourceFor } from '../lib/pictureSource';

const work = getWork();
const writings = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Compute the strip src/srcset for the first project's first asset so we can
// preload the LCP image. Mirrors WorkRow's resolveStripSrc (poster >
// youtube-derived > src), prefers the 1x/2x '-thumb.webp' sidecars, and resolves
// the avif siblings so the preload matches the <source> the browser will pick.
const firstAsset = work[0]?.assets?.[0];
function firstStrip(): { src?: string; srcset?: string; avif: string | null } {
  if (!firstAsset) return { avif: null };
  const ref =
    firstAsset.poster
    ?? ((firstAsset.type == null || firstAsset.type === 'image') ? firstAsset.src : undefined)
    ?? firstAsset.src;
  if (!ref?.startsWith('/') || firstAsset.type === 'gif') return { src: ref, avif: null };
  const t2 = thumbPath(ref);
  if (!existsSync(`${process.cwd()}/public${t2}`)) return { src: ref, avif: null };
  const t1 = thumbPath1x(ref);
  const has1 = existsSync(`${process.cwd()}/public${t1}`);
  const src = has1 ? t1 : t2;
  const srcset = has1 ? `${t1} 1x, ${t2} 2x` : undefined;
  return { src, srcset, avif: avifSourceFor(src, srcset) };
}
const lcp = firstStrip();
---
<PortfolioLayout title="Ross Miller">
  {lcp.avif
    ? <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={lcp.avif} fetchpriority="high" />
    : lcp.src && <link slot="head" rel="preload" as="image" href={lcp.src} fetchpriority="high" />}
  <main class="container" data-rise>
    <h1 class="name" style="--rise-i:0; --rise-from-y:0px; --rise-blur-from:8px; --rise-dur:1.2s">Ross Miller</h1>
    <p class="title" style="--rise-i:0; --rise-from-y:0px; --rise-blur-from:8px; --rise-dur:1.2s">Developer, designer, 4x founder</p>
    <div class="bio" style="--rise-i:0">
      <p>I lead with empathy, level up the people around me, build things that matter, and care deeply about craft.</p>

      <p>You can find me on <a href="https://www.linkedin.com/in/rossnmiller/" target="_blank" rel="noopener noreferrer">LinkedIn</a>, <a href="https://github.com/rsml" target="_blank" rel="noopener noreferrer">GitHub</a>, <a href="https://x.com/rossmllr" target="_blank" rel="noopener noreferrer">X</a>, or reach me via <a href="mailto:rossnmiller@gmail.com">email</a>.</p>
    </div>
    <h2 class="home-section-h" style="--rise-i:1">Writing</h2>
    <ul class="writings" style="--rise-i:2">
      {writings.map((w) => {
        const label = w.data.date.toLocaleDateString('en-US', {
          month: 'long',
          year: 'numeric',
        });
        return (
          <li>
            <a href={`/writing/${w.id}`}>
              <span class="writing-title">{w.data.title}</span>
              <span class="writing-date">{label}</span>
            </a>
          </li>
        );
      })}
    </ul>
    <h2 class="home-section-h" style="--rise-i:2">Selected work</h2>
    <div class="work" style="--rise-i:0">
      {work.map((p, i) => <WorkRow project={p} eager={i === 0} />)}
    </div>
    <NowClock style="--rise-i:3" />
  </main>
  <Lightbox projects={work} />
</PortfolioLayout>
<style>
  h1.name { margin: 0 0 2px; padding-top: 30px; font-size: 14px; font-weight: 500; }
  .title { margin: 0; color: var(--muted); }
  .bio { margin: 40px 0 50px; }
  .bio p { margin: 0 0 12px; }
  .bio p:last-child { margin-bottom: 0; }
  /* Same treatment as the work links: a quiet underline at rest that fills to
     full ink on hover. text-decoration-color animates (background-image can't),
     so the fill is a smooth fade, not a snap. */
  .bio a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--ink) 22%, transparent);
    transition: text-decoration-color 200ms ease;
  }
  .bio a:hover { text-decoration-color: var(--ink); }
  h2.home-section-h { margin: 0 0 8px; font-size: 11px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .work { margin: 0; }
  .writings {
    list-style: none;
    margin: 0 0 48px;
    padding: 0;
    max-width: 600px;
  }
  .writings li { display: block; }
  .writings a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 4px 6px;
    margin: 0 -6px;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
    transition: background 120ms ease;
  }
  .writings a:hover { background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .writing-title { flex: 0 0 auto; }
  .writing-date {
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>

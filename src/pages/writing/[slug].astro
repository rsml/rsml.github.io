---
import { getCollection, render } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import BackLink from '../../components/BackLink.astro';
import TableOfContents from '../../components/writing/TableOfContents.astro';

export async function getStaticPaths() {
  const essays = await getCollection('writing');
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content, headings } = await render(essay);
const formattedDate = essay.data.date.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});
---
<PortfolioLayout
  title={`${essay.data.title} - Ross Miller`}
  description={essay.data.description}
>
  <main class="essay-shell" data-rise>
    <div class="rise-slot back-row" style="--rise-i:0">
      <BackLink />
    </div>
    <TableOfContents headings={headings} />
    <article style="--rise-i:1">
      <header class="essay-header">
        <h1 class="essay-title">{essay.data.title}</h1>
        <time class="essay-date" datetime={essay.data.date.toISOString()}>
          {formattedDate}
        </time>
      </header>
      <div class="essay-body">
        <Content />
      </div>
    </article>
  </main>
</PortfolioLayout>
<style>
  /* Symmetric 3-column grid: the reading column stays dead-center in the
     viewport (so the title/prose never shift), while the table of contents
     floats in the left gutter. min(720px, 100% - 48px) keeps the old 24px side
     gutters on narrow screens without a media query. */
  .essay-shell {
    display: grid;
    grid-template-columns: 1fr min(720px, 100% - 48px) 1fr;
    align-items: start;
    padding: 80px 0 120px;
  }
  .back-row { grid-column: 2; margin-bottom: 48px; }
  .essay-shell > article { grid-column: 2; }

  /* At the width where the rail fits, pin the back link and article to the
     center column's two rows; the rail (grid-column 1) shares the article row. */
  @media (min-width: 1200px) {
    .back-row { grid-row: 1; }
    .essay-shell > article { grid-row: 2; }
  }
  .essay-header { margin-bottom: 64px; }
  .essay-title {
    margin: 0 0 12px;
    font-size: 48px;
    font-weight: 590;
    line-height: 1.0;
    letter-spacing: -1.05px;
  }
  .essay-date {
    display: block;
    color: var(--muted);
    font-size: 14px;
  }
  .essay-body {
    font-size: 17px;
    line-height: 1.6;
    font-weight: 400;
    letter-spacing: normal;
  }
  /* :global() required — MDX-rendered children don't get the Astro scope attribute */
  .essay-body :global(p) { margin: 0 0 1.4em; }
  .essay-body :global(p:last-child) { margin-bottom: 0; }
  .essay-body :global(h2) {
    margin: 2.5em 0 0.5em;
    font-size: 26px;
    font-weight: 620;
    letter-spacing: -0.3px;
    color: var(--ink);
  }
  .essay-body :global(h3) {
    margin: 2em 0 0.4em;
    font-size: 18px;
    font-weight: 580;
    letter-spacing: -0.15px;
  }
  .essay-body :global(h4) {
    margin: 1.7em 0 0.4em;
    font-size: 16px;
    font-weight: 580;
    letter-spacing: -0.1px;
    color: var(--ink);
  }
  /* Offset in-page anchor landings (TOC clicks, native #hash) clear of the
     fixed top blur. Matches the rail's sticky --toc-top. */
  .essay-body :global(h2),
  .essay-body :global(h3),
  .essay-body :global(h4) { scroll-margin-top: 96px; }
  .essay-body :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }
  .essay-body :global(code) {
    font-family: ui-monospace, "SF Mono", "Fira Code", monospace;
    font-size: 0.88em;
    background: var(--shot-bg);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .essay-body :global(pre) {
    background: var(--shot-bg);
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.6;
  }
  .essay-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }
  .essay-body :global(blockquote) {
    margin: 0 0 1.4em;
    padding: 0 0 0 16px;
    border-left: 2px solid var(--hair);
    color: var(--muted);
  }
  .essay-body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--ink) 22%, transparent);
    transition: text-decoration-color 200ms ease;
  }
  .essay-body :global(a:hover) { text-decoration-color: var(--ink); }
</style>
